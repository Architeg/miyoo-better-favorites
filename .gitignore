# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Build output
build/*
!build/.gitkeep

dist/
out/

# Compiled binaries
*.o
*.a
*.so
*.dylib
*.exe

# Logs / temp files
*.log
*.tmp
*.bak
__pycache__/
*.pyc

# Device-local app executable and preferences/browser state
/App/BetterFavoritesTest/better-favorites
/App/BetterFavoritesTest/settings.conf
/App/BetterFavoritesTest/settings.conf.*
/App/BetterFavoritesTest/browser-state
/App/BetterFavoritesTest/browser-state.*

# Local Miyoo / SD test folders
sdcard/
sdcard-test/
sdcard-staging/
local-backups/

# Third-party downloaded binaries/libraries
third_party/bin/
third_party/cache/

# Packaging output
packaging/output/

# External/generated development dependencies
third_party/sdl2_miyoo/
third_party/json-c/
third_party/sdl2_ttf/
third_party/sdl2_image/

# App-owned favorite backups (never distribution content)
.favourite.json.better-favorites-backup.*
